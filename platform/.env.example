# The only required setting: a Comfy Developer Platform key (platform.comfy.org → API Keys).
# Every model and every language model call goes through the Comfy Router with it.
COMFY_API_KEY=

# --- Optional -----------------------------------------------------------------------------------------------------
# Credits per Comfy credit you charge (1 = pass the router's price on unchanged).
# CREDIT_MARKUP=1
# Start credits of the local account in local mode (no Supabase). Bookkeeping only; Comfy bills the real cost.
# LOCAL_CREDITS=2000
# Language models (OpenRouter model slugs on the router's chat route).
# PROMPT_WRITER_MODEL=anthropic/claude-haiku-5.5
# UPLOAD_SCAN_MODEL=google/gemini-3.8-flash

# Accounts, sign-in and persistence (without these: one local account, data in memory, files in .data/media).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# DATABASE_URL=
# MEDIA_STORE=supabase

# Signed media links and webhooks (any long random string).
# MEDIA_LINK_SECRET=
# PUBLIC_BASE_URL=https://your-domain

# Payments (Stripe), mail (Resend), operators, cron.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
# MAIL_FROM=
# OPERATOR_EMAILS=
# CRON_SECRET=
